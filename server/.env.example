PORT=5000
# no database name and no trailing slash: the code adds /quickgpt itself
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
JWT_SECRET=any_long_random_string
GEMINI_API_KEY=your_google_ai_studio_key

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- optional (defaults shown) ----
# RAG_COLLECTION=rag_chunks        Atlas collection that holds the PDF chunks
# VECTOR_INDEX_NAME=vector_index   name of the Atlas Vector Search index
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMS=3072              must equal numDimensions in the Atlas index
# HISTORY_MESSAGES=10              how many earlier messages Gemini remembers
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
# MAX_PDF_MB=4
